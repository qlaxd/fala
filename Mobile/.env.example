# API Configuration
API_URL_DEV=http://localhost:3000/api
API_URL_STAGING=https://staging-api.falafarm.com/api
API_URL_PROD=https://api.falafarm.com/api

# Authentication
AUTH_TOKEN_KEY=@FalaFarmAuth:token
AUTH_USER_KEY=@FalaFarmAuth:user

# Image Upload
IMAGE_UPLOAD_URL=https://upload.falafarm.com
IMAGE_COMPRESSION_QUALITY=0.8
MAX_IMAGE_WIDTH=1200
MAX_IMAGE_HEIGHT=1200

# Notifications
PUSH_ENABLED=true
NOTIFICATION_CHANNEL_ID=fala-farm-notifications

# Development
DEBUG=false 